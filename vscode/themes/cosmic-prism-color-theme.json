  ],
  "semanticTokenColors": {
    "namespace": "#85CEC4",
    "type": "#85CEC4",
    "class": "#85CEC4",
    "struct": "#85CEC4",
    "enum": "#85CEC4",
    "interface": "#85CEC4",
    "typeParameter": "#85CEC4",
    "builtinType": "#85CEC4",
    "function": "#D5EDEB",
    "method": "#D5EDEB",
    "macro": "#E5C697",
    "decorator": "#E5C697",
    "parameter": {
      "foreground": "#A6AFC9",
      "italic": true
    },
    "variable": "#E0F7FA",
    "property": "#E0F7FA",
    "enumMember": "#FFA69E",
    "event": "#E0F7FA",
    "label": "#F7C3C6",
    "keyword": "#F7C3C6",
    "selfKeyword": "#E5C697",
    "selfParameter": "#E5C697",
    "selfTypeKeyword": "#85CEC4",
    "builtinConstant": "#FFA69E",
