# PrismDay for Ghostty, part of cosmic-prismday-theme (MIT).
# Colours follow the COSMIC Terminal scheme (cosmic-term/).
#
# Install: ./ghostty/install.sh puts this in ~/.config/ghostty/themes/, then in
# ~/.config/ghostty/config:
#   theme = PrismDay
# or, with the Prism half installed too, following COSMIC's Dark / Light toggle:
#   theme = dark:Prism,light:PrismDay

